<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep real files and directories available as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send client-side routes (including /admin) back to the React entry point.
  RewriteRule ^ index.html [L]
</IfModule>
