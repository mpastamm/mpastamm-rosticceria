# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Local-only fallback. Keep false in production.
VITE_ALLOW_LOCAL_ADMIN="false"
VITE_DEMO_ADMIN_EMAIL="admin@example.com"
VITE_DEMO_ADMIN_PASSWORD="change-me-locally"

# ==========================================
# WHATSAPP BUSINESS CLOUD API (Meta)
# ==========================================
# Token permanente o di test rilasciato da Meta for Developers
WHATSAPP_API_TOKEN=""
# Phone Number ID fornito nella dashboard WhatsApp di Meta
WHATSAPP_PHONE_NUMBER_ID=""
# Numero di telefono della rosticceria su cui ricevere le notifiche (es. 393331234567)
RESTAURANT_WHATSAPP_NUMBER="393331234567"

# ==========================================
# STRIPE CHECKOUT (server-side secrets)
# ==========================================
# Usa prima le chiavi della modalità Test (sk_test_...). Non inserirle nel frontend.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# In locale deve puntare al server Vite/Express; su Cloudflare a https://mpastamm.it
APP_URL="http://localhost:3000"
# Necessari al server per verificare prezzi e salvare il pagamento in Supabase.
SUPABASE_SERVICE_ROLE_KEY=""
